  const msg = document.getElementById('msg');
  const reglas = [
    { patron: /(prend|encend|enciend).*luz|luz.*(prend|encend|enciend)/, comando: 'luz_on', ok: 'Listo, encendi la luz' },
    { patron: /apag.*luz|luz.*apag/, comando: 'luz_off', ok: 'Listo, apague la luz' },
    { patron: /abr.*persiana|persiana.*abr/, comando: 'persiana_abrir', ok: 'Abriendo la persiana' },
    { patron: /(cerr|cierr).*persiana|persiana.*(cerr|cierr)/, comando: 'persiana_cerrar', ok: 'Cerrando la persiana' },
    { patron: /(siguiente|cambia|otro).*cuadro|cuadro.*(siguiente|cambia|otro)/, comando: 'cuadro_siguiente', ok: 'Cambiando el cuadro' },
  ];
  function burbuja(texto, tipo) {
    const d = document.createElement('div');
    d.className = 'burbuja ' + tipo;
    d.textContent = texto;
    chat.appendChild(d);
    chat.scrollTop = chat.scrollHeight;
  }
  async function enviarTexto(forzado) {
    const texto = (forzado !== undefined ? forzado : msg.value).trim();
    if (!texto) return;
    burbuja(texto, 'usuario');
    msg.value = '';
    const r = reglas.find(x => x.patron.test(texto.toLowerCase()));
    if (!r) { burbuja('No entendi ese comando.', 'error'); return; }
    try {
      await fetch('/comando?accion=' + r.comando);
      burbuja(r.ok, 'bot');
    } catch(e) {
      burbuja('Error de conexion con el ESP32', 'error');
    }
  }
  msg.addEventListener('keydown', e => { if (e.key === 'Enter') enviarTexto(); });
