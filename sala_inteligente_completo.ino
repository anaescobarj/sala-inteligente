void setup() {
  Serial.begin(115200);

  // Luz
  pinMode(PIN_LUZ, OUTPUT);
  digitalWrite(PIN_LUZ, LOW);

  // Servo (persiana)
  ledcAttach(PIN_SERVO, 50, 16);
  moverServo(anguloCerrada);

  // Piano
  for (int i = 0; i < 7; i++) {
    pinMode(teclas[i], INPUT_PULLUP);
  }
  ledcAttach(pinBuzzer, 2000, 8);

  // OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("Error: no se detecta la pantalla OLED");
  } else {
    mostrarCuadro(cuadroActual);
  }

  // WiFi
  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi");
  int intentos = 0;
  while (WiFi.status() != WL_CONNECTED && intentos < 40) {
    delay(500);
    Serial.print(".");
    intentos++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println();
    Serial.print("Conectado. Abre esta direccion en Safari: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println();
    Serial.println("NO SE PUDO CONECTAR AL WIFI.");
  }

  server.on("/", handleRoot);
  server.on("/comando", manejarComando);
  server.begin();
  Serial.println("Servidor HTTP iniciado");
}

void loop() {
  server.handleClient();
  revisarPiano();
}

// ---------- FUNCIONES ----------

void handleRoot() {
  server.send(200, "text/html", paginaHTML);
}

void moverServo(int angulo) {
  int pulso = map(angulo, 0, 360, 500, 2500);
  int duty = (pulso * 65536) / 20000;
  ledcWrite(PIN_SERVO, duty);
}

void manejarComando() {
  if (!server.hasArg("accion")) {
    server.send(400, "text/plain", "Falta parametro 'accion'");
    return;
  }
  String accion = server.arg("accion");
  accion.toLowerCase();
  String respuesta = "OK";

  if (accion == "luz_on") {
    luzEncendida = true;
    digitalWrite(PIN_LUZ, HIGH);
    respuesta = "Luz encendida";
  }
  else if (accion == "luz_off") {
    luzEncendida = false;
    digitalWrite(PIN_LUZ, LOW);
    respuesta = "Luz apagada";
  }
  else if (accion == "persiana_abrir") {
    moverServo(anguloAbierta);
    persianaAbierta = true;
    respuesta = "Persiana abierta";
  }
  else if (accion == "persiana_cerrar") {
    moverServo(anguloCerrada);
    persianaAbierta = false;
    respuesta = "Persiana cerrada";
  }
  else if (accion == "cuadro_siguiente") {
    cuadroActual = (cuadroActual + 1) % totalCuadros;
    mostrarCuadro(cuadroActual);
    respuesta = "Cuadro cambiado";
  }
  else {
    respuesta = "Comando no reconocido: " + accion;
    server.send(404, "text/plain", respuesta);
    return;
  }
  Serial.println(respuesta);
  server.send(200, "text/plain", respuesta);
}

void revisarPiano() {
  bool algoSonando = false;
  for (int i = 0; i < 7; i++) {
    if (digitalRead(teclas[i]) == LOW) {
      ledcWriteTone(pinBuzzer, notas[i]);
      algoSonando = true;
      break;
    }
  }
  if (!algoSonando) {
    ledcWriteTone(pinBuzzer, 0);
  }
}

void mostrarCuadro(int indice) {
  display.clearDisplay();
  switch (indice) {
    case 0: display.drawBitmap(0, 0, obra1, 128, 64, SSD1306_WHITE); break;
    case 1: display.drawBitmap(0, 0, obra2, 128, 64, SSD1306_WHITE); break;
    case 2: display.drawBitmap(0, 0, obra3, 128, 64, SSD1306_WHITE); break;
  }
  display.display();
}